# Two names that both resolve to this server. VIEW_HOST must be a subdomain of the same domain as APP_HOST
# (the camera session cookie is SameSite=Strict).
APP_HOST=app.example.com
VIEW_HOST=view.example.com
ACME_EMAIL=you@example.com
# 1 = anyone can create an account; 0 = create accounts with the admin CLI (recommended while selling by invitation)
ALLOW_SIGNUP=0
CONTROL_ENABLED=1
# Optional: a fixed session secret (>= 32 chars). Empty = generated once and kept in the data volume.
SESSION_SECRET=
