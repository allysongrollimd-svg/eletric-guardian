# --- Obrigatório ---
# Token para abrir o painel (o telemetry inclui posição GPS: use um valor longo e aleatório).
#   openssl rand -hex 24
DASHBOARD_TOKEN=troque-por-um-token-longo

# --- Como os dados chegam (use um ou ambos) ---
# 1) MQTT: o mesmo broker configurado no app (Configurações > MQTT).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=guardian
MQTT_PASSWORD=troque-esta-senha
# Tópico no app: electric-guardian/<carro>/telemetry  (padrão do app: electric-guardian/car/telemetry -> veículo "car").
# Com vários carros, use um tópico por carro (electric-guardian/seal/telemetry) e deixe o padrão abaixo.
MQTT_TOPIC=electric-guardian/+/telemetry

# 2) HTTP: POST /api/ingest/<veiculo> com "Authorization: Bearer <INGEST_TOKEN>"
INGEST_TOKEN=

# --- Opcional ---
PORT=8787
OFFLINE_AFTER_SECONDS=90
HISTORY_MAX_POINTS=4000
# DEMO=1 liga um carro simulado; ALLOW_INSECURE=1 só para testes locais (sem token).

# --- Controle remoto (comandos do painel -> carro, via MQTT) ---
# Exige no app: Configurações > MQTT > "Home Assistant" ligado + "Permitir controle" ligado.
# Desligado por padrão. O PIN é pedido para desbloquear os controles (10 min) e deve ser diferente do DASHBOARD_TOKEN.
CONTROL_ENABLED=0
CONTROL_PIN=
CONTROL_UNLOCK_SECONDS=600
