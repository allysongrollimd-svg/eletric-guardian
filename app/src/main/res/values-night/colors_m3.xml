<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 token palette — DARK theme.
  Generated from seed #4ED400. Surfaces follow M3 elevation tonal stepping
  (dim/bright + 5 container tiers) so we can stack two surfaces without
  needing elevation shadows that read poorly on dark.
-->
<resources>

    <!-- Primary -->
    <color name="md_sys_color_primary_dark">#8BDC5C</color>
    <color name="md_sys_color_on_primary_dark">#0E2600</color>
    <color name="md_sys_color_primary_container_dark">#173F00</color>
    <color name="md_sys_color_on_primary_container_dark">#A5F477</color>

    <!-- Secondary -->
    <color name="md_sys_color_secondary_dark">#AFBCCE</color>
    <color name="md_sys_color_on_secondary_dark">#1E2A16</color>
    <color name="md_sys_color_secondary_container_dark">#313D4D</color>
    <color name="md_sys_color_on_secondary_container_dark">#D7E8CD</color>

    <!-- Tertiary -->
    <color name="md_sys_color_tertiary_dark">#85CFFF</color>
    <color name="md_sys_color_on_tertiary_dark">#00344C</color>
    <color name="md_sys_color_tertiary_container_dark">#004C6C</color>
    <color name="md_sys_color_on_tertiary_container_dark">#C5E7FF</color>

    <!-- Error -->
    <color name="md_sys_color_error_dark">#FFB4AB</color>
    <color name="md_sys_color_on_error_dark">#690005</color>
    <color name="md_sys_color_error_container_dark">#93000A</color>
    <color name="md_sys_color_on_error_container_dark">#FFDAD6</color>

    <!-- Background / surfaces — green-black; the seed hue is carried into the
         neutrals themselves rather than left grey. -->
    <color name="md_sys_color_background_dark">#000000</color>
    <color name="md_sys_color_on_background_dark">#E6EDE9</color>
    <color name="md_sys_color_surface_dark">#000000</color>
    <color name="md_sys_color_on_surface_dark">#E6EDE9</color>
    <color name="md_sys_color_surface_variant_dark">#2B3440</color>
    <color name="md_sys_color_on_surface_variant_dark">#B1B9C5</color>
    <color name="md_sys_color_surface_dim_dark">#000000</color>
    <color name="md_sys_color_surface_bright_dark">#1F2F15</color>
    <color name="md_sys_color_surface_container_lowest_dark">#000000</color>
    <color name="md_sys_color_surface_container_low_dark">#020301</color>
    <color name="md_sys_color_surface_container_dark">#070C04</color>
    <color name="md_sys_color_surface_container_high_dark">#0E1709</color>
    <color name="md_sys_color_surface_container_highest_dark">#16240F</color>

    <!-- Outline / dividers -->
    <color name="md_sys_color_outline_dark">#7C8592</color>
    <color name="md_sys_color_outline_variant_dark">#232A34</color>

    <!-- Inverse / scrim -->
    <color name="md_sys_color_inverse_surface_dark">#DEE4E0</color>
    <color name="md_sys_color_inverse_on_surface_dark">#2D2F31</color>
    <color name="md_sys_color_inverse_primary_dark">#2B7500</color>
    <color name="md_sys_color_scrim_dark">#000000</color>

    <!-- Brand-aware status colors -->
    <color name="overdrive_status_success_dark">#5BD382</color>
    <color name="overdrive_status_warning_dark">#FFB870</color>
    <color name="overdrive_status_danger_dark">#FFB4AB</color>
    <color name="overdrive_status_info_dark">#85CFFF</color>

    <!-- Container tones for the status colors above, for status pills that need
         a fill rather than just text. Alpha lets the hero card's ribbon carry
         through the pills. -->
    <color name="overdrive_status_success_container_dark">#CC0F2304</color>
    <color name="overdrive_status_warning_container_dark">#CC33240C</color>
    <color name="overdrive_status_danger_container_dark">#CC3A1512</color>
    <color name="overdrive_status_info_container_dark">#CC062F42</color>

    <!-- Dark overrides for the public semantic color contract. -->
    <color name="md_sys_color_primary">@color/md_sys_color_primary_dark</color>
    <color name="md_sys_color_on_primary">@color/md_sys_color_on_primary_dark</color>
    <color name="md_sys_color_primary_container">@color/md_sys_color_primary_container_dark</color>
    <color name="md_sys_color_on_primary_container">@color/md_sys_color_on_primary_container_dark</color>
    <color name="md_sys_color_secondary">@color/md_sys_color_secondary_dark</color>
    <color name="md_sys_color_on_secondary">@color/md_sys_color_on_secondary_dark</color>
    <color name="md_sys_color_secondary_container">@color/md_sys_color_secondary_container_dark</color>
    <color name="md_sys_color_on_secondary_container">@color/md_sys_color_on_secondary_container_dark</color>
    <color name="md_sys_color_tertiary">@color/md_sys_color_tertiary_dark</color>
    <color name="md_sys_color_on_tertiary">@color/md_sys_color_on_tertiary_dark</color>
    <color name="md_sys_color_tertiary_container">@color/md_sys_color_tertiary_container_dark</color>
    <color name="md_sys_color_on_tertiary_container">@color/md_sys_color_on_tertiary_container_dark</color>
    <color name="md_sys_color_error">@color/md_sys_color_error_dark</color>
    <color name="md_sys_color_on_error">@color/md_sys_color_on_error_dark</color>
    <color name="md_sys_color_error_container">@color/md_sys_color_error_container_dark</color>
    <color name="md_sys_color_on_error_container">@color/md_sys_color_on_error_container_dark</color>
    <color name="md_sys_color_background">@color/md_sys_color_background_dark</color>
    <color name="md_sys_color_on_background">@color/md_sys_color_on_background_dark</color>
    <color name="md_sys_color_surface">@color/md_sys_color_surface_dark</color>
    <color name="md_sys_color_on_surface">@color/md_sys_color_on_surface_dark</color>
    <color name="md_sys_color_surface_variant">@color/md_sys_color_surface_variant_dark</color>
    <color name="md_sys_color_on_surface_variant">@color/md_sys_color_on_surface_variant_dark</color>
    <color name="md_sys_color_surface_dim">@color/md_sys_color_surface_dim_dark</color>
    <color name="md_sys_color_surface_bright">@color/md_sys_color_surface_bright_dark</color>
    <color name="md_sys_color_surface_container_lowest">@color/md_sys_color_surface_container_lowest_dark</color>
    <color name="md_sys_color_surface_container_low">@color/md_sys_color_surface_container_low_dark</color>
    <color name="md_sys_color_surface_container">@color/md_sys_color_surface_container_dark</color>
    <color name="md_sys_color_surface_container_high">@color/md_sys_color_surface_container_high_dark</color>
    <color name="md_sys_color_surface_container_highest">@color/md_sys_color_surface_container_highest_dark</color>
    <color name="md_sys_color_outline">@color/md_sys_color_outline_dark</color>
    <color name="md_sys_color_outline_variant">@color/md_sys_color_outline_variant_dark</color>
    <color name="md_sys_color_inverse_surface">@color/md_sys_color_inverse_surface_dark</color>
    <color name="md_sys_color_inverse_on_surface">@color/md_sys_color_inverse_on_surface_dark</color>
    <color name="md_sys_color_inverse_primary">@color/md_sys_color_inverse_primary_dark</color>
    <color name="md_sys_color_scrim">@color/md_sys_color_scrim_dark</color>
    <color name="overdrive_status_success">@color/overdrive_status_success_dark</color>
    <color name="overdrive_status_warning">@color/overdrive_status_warning_dark</color>
    <color name="overdrive_status_danger">@color/overdrive_status_danger_dark</color>
    <color name="overdrive_status_info">@color/overdrive_status_info_dark</color>
    <color name="overdrive_status_success_container">@color/overdrive_status_success_container_dark</color>
